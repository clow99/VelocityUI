{
  "name": "@velocityuikit/velocityui",
  "version": "0.1.19",
  "description": "A modern, accessible React component library",
  "license": "MIT",
  "author": "Cameron Low (https://cameronlow.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/clow99/VelocityUI.git"
  },
  "homepage": "https://github.com/clow99/VelocityUI",
  "bugs": {
    "url": "https://github.com/clow99/VelocityUI/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --declarationDir dist && vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.1.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
